{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "model_context_windows": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "type": "integer", "minimum": 1000 }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "array",
      "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
      "minItems": 1
    },
    "stale_turns": { "type": "integer", "minimum": 1 },
    "hotkey": { "type": "string", "pattern": "^C-.?$" },
    "daemon_socket": { "type": "string", "format": "uri-reference" },
    "session_dir": { "type": "string", "format": "uri-reference" }
  },
  "required": ["model_context_windows", "thresholds", "stale_turns", "hotkey", "daemon_socket", "session_dir"],
  "additionalProperties": false
}